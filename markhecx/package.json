{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern markhecx",
    "db:generate": "drizzle-kit generate",
    "backend:dev": "node --env-file-if-exists=server/.env --import tsx server/index.ts",
    "backend:build": "tsc -p server/tsconfig.json --noEmit && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server/dist/index.mjs",
    "backend:start": "node --env-file-if-exists=server/.env server/dist/index.mjs",
    "test:regression": "node scripts/test-regression.mjs",
    "test:backend": "HECX_PROVIDER=mock NODE_ENV=test MONGODB_DATABASE=markhecx_test node --import tsx --test --test-concurrency=1 server/tests/*.test.ts",
    "test:matching": "node --import tsx scripts/evaluate-matching.ts",
    "backend:mongo:init": "node scripts/init-local-mongo.mjs && node --env-file-if-exists=server/.env --import tsx scripts/init-backend.ts",
    "test:gemini:live": "node --env-file=server/.env --import tsx scripts/smoke-gemini.ts",
    "test:full-stack:live": "HECX_PROVIDER=gemini NODE_ENV=test MONGODB_DATABASE=markhecx_test node --env-file=server/.env --import tsx scripts/smoke-full-stack.ts",
    "start:local": "node scripts/start-local.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@google/genai": "^2.27.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "10.9.1",
    "helmet": "^8.3.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "mongodb": "^6.21.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
