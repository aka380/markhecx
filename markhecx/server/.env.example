NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=markhecx
MONGODB_DATABASE=markhecx
WEB_ORIGINS=http://127.0.0.1:3001
SESSION_DAYS=7
# mock is deterministic and needs no secrets; external providers run server-side.
HECX_PROVIDER=mock
# External providers can be injected through server/services/hecx.ts.
# Keep their credentials only in this server environment.

# Select gemini explicitly to enable real AI; mock never replaces a Gemini failure.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
HECX_TIMEOUT_MS=25000

# Recovery email: configure a verified sender and Resend key for actual delivery.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=

# Same Web application OAuth client ID as the frontend. No client secret needed for GIS ID tokens.
GOOGLE_CLIENT_ID=
