# Server-only settings for the unified Next.js app. Set Production values in Vercel.
# Local development reads server/.env; never commit populated environment files.
MONGODB_URI=
MONGODB_DATABASE=markhecx
WEB_ORIGINS=https://markhecx.vercel.app
GOOGLE_CLIENT_ID=
SESSION_DAYS=7
HECX_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
# No separate backend URL or NEXT_PUBLIC secrets are needed.
